# Database Configuration
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For local development with Docker: postgresql://tahoak:tahoak_password@tahoak-db:5432/tahoak_db
# For local development (host): postgresql://tahoak:tahoak_password@localhost:5432/tahoak_db
DATABASE_URL=postgresql://tahoak:CHANGE_ME@localhost:5432/tahoak_db

# NextAuth Configuration
# Generate a secure random string for production (e.g., openssl rand -base64 32)
# This secret is used to encrypt JWT tokens and session data
NEXTAUTH_SECRET=CHANGE_ME_IN_PRODUCTION
NEXTAUTH_URL=http://localhost:3000

# Node Environment
# Options: development, production, test
NODE_ENV=development

# Seed (npm run db:seed)
# Admin password used only when admin@tahoak.com doesn't exist yet.
# Leave unset in production to have the seed generate and print one.
SEED_ADMIN_PASSWORD=password123
# Create the owner@tahoak.com / owner123 test user. Local development only.
SEED_TEST_USERS=true

# Optional: Database connection pool settings
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
