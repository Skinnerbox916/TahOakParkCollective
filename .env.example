# Database Configuration
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For local development with Docker: postgresql://tahoak:tahoak_password@tahoak-db:5432/tahoak_db
# For local development (host): postgresql://tahoak:tahoak_password@localhost:5432/tahoak_db
DATABASE_URL=postgresql://tahoak:CHANGE_ME@localhost:5432/tahoak_db

# Auth (Better Auth). The secret signs session cookies: at least 32 random
# characters (openssl rand -base64 32). The URL is the site's public origin;
# passkeys only work on exactly this host.
BETTER_AUTH_SECRET=CHANGE_ME_IN_PRODUCTION_AT_LEAST_32_CHARS
BETTER_AUTH_URL=http://localhost:3000
# Brand shown in emails, passkey prompts and authenticator apps
APP_NAME=TahOak Park Collective

# Email (SMTP). Leave SMTP_HOST unset in development: emails, including
# sign-in codes, are printed to the server log instead. Required in production.
# SMTP_HOST=smtp.migadu.com
# SMTP_PORT=465
# SMTP_USER=tahoak@canopyds.com
# SMTP_PASSWORD=
# EMAIL_FROM="TahOak Park Collective <tahoak@canopyds.com>"
# EMAIL_REPLY_TO=support@canopyds.com

# Node Environment
# Options: development, production, test
NODE_ENV=development

# Seed (npm run db:seed)
# Admin password used only when admin@tahoak.com doesn't exist yet.
# Leave unset in production to have the seed generate and print one.
SEED_ADMIN_PASSWORD=password123
# Create the owner@tahoak.com / owner123 test user. Local development only.
SEED_TEST_USERS=true

# Machine translation (DeepL). Keys ending in :fx use the free API endpoint.
# Optional in development (a mock provider prefixes "[ES] "); required in
# production for the admin/portal auto-translate buttons.
DEEPL_API_KEY=

# Optional: Database connection pool settings
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
