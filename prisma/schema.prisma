// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  emailVerified    Boolean        @default(false) @map("email_verified")
  image            String?
  // Admin plugin: "user" or "admin". Admin powers also need a strong
  // session (passkey or authenticator code); see src/lib/auth.ts.
  role             String         @default("user")
  banned           Boolean?       @default(false)
  banReason        String?
  banExpires       DateTime?
  twoFactorEnabled Boolean?       @default(false)
  locale           String         @default("en") // language for emails
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt

  memberships      EntityMember[]
  consents         Entity[]       @relation("EntityConsent")
  authSessions     AuthSession[]
  authAccounts     AuthAccount[]
  passkeys         Passkey[]
  twoFactors       TwoFactor[]
}

model Category {
  id                   String      @id @default(cuid())
  name                 String      @unique
  nameTranslations     Json?       // JSON: { "en": "...", "es": "..." }
  slug                 String      @unique
  description          String?
  descriptionTranslations Json?    // JSON: { "en": "...", "es": "..." }
  featured             Boolean     @default(false)
  entityTypes          EntityType[]
  entities             Entity[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model Entity {
  id                      String          @id @default(cuid())
  name                    String
  nameTranslations        Json?           // JSON: { "en": "...", "es": "..." }
  slug                    String          @unique
  description             String?         @db.Text
  descriptionTranslations Json?           // JSON: { "en": "...", "es": "..." }
  seoTitleTranslations    Json?           // JSON: { "en": "...", "es": "..." } - SEO title (50-60 chars recommended)
  seoDescriptionTranslations Json?        // JSON: { "en": "...", "es": "..." } - SEO description (150-160 chars recommended)
  address                 String?
  phone                   String?
  website                 String?
  latitude                Float?
  longitude               Float?
  categories              Category[]
  entityType              EntityType      @default(COMMERCE)
  status                  EntityStatus    @default(ACTIVE)
  featured                Boolean         @default(false)
  images                  Json?           // Array of image URLs
  hours                   Json?           // Business hours structure
  socialMedia             Json?           // Social media links
  displaySettings         Json?           // Controls which fields are displayed on the public profile
  members                 EntityMember[]
  
  // MVP fields
  tags                EntityTag[]
  approvals           Approval[]       @relation("ApprovalCreatedEntity")
  approvalTargets     Approval[]       @relation("ApprovalTargetEntity")
  spotCheckDate       DateTime?
  verificationContact String?
  issueReports        IssueReport[]

  // Bumped on every write by src/lib/entities. Approvals record the version
  // they were based on, so stale proposals are detected instead of applied.
  version       Int             @default(1)

  // Owner opt-in (src/lib/entities/consent.ts). Only publish/unpublish write
  // these. A CHECK constraint (migration 20261125000000_owner_opt_in) keeps
  // listings that need consent from being ACTIVE without it.
  consentedAt         DateTime?
  consentedById       String?
  consentedBy         User?             @relation("EntityConsent", fields: [consentedById], references: [id], onDelete: SetNull)
  consentTermsVersion String?
  shareLinks          EntityShareLink[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([slug])
  @@index([status])
  @@index([featured])
  @@index([entityType])
}

// People who manage a listing. A listing with no members is unclaimed.
model EntityMember {
  id        String     @id @default(cuid())
  entityId  String
  userId    String
  role      MemberRole @default(OWNER)
  addedBy   String?    // User ID of the admin (or approval) that added them
  createdAt DateTime   @default(now())
  entity    Entity     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entityId, userId])
  @@index([userId])
}

// New Models for MVP

/// A private link to a draft listing that an admin shares with its owner by
/// text or email. Opening it shows the listing; the owner can then take it
/// over and publish it. Single use. Only the SHA-256 of the token is stored.
model EntityShareLink {
  id          String    @id @default(cuid())
  entityId    String
  entity      Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  sentTo      String?   // email address, when it was emailed
  locale      String    @default("en")
  createdById String?   // admin who shared it
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  revokedAt   DateTime?

  @@index([entityId])
}

model Tag {
  id              String      @id @default(cuid())
  name            String      @unique
  nameTranslations Json?      // JSON: { "en": "...", "es": "..." }
  slug            String      @unique
  category        TagCategory
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  entities        EntityTag[]
  
  @@index([category])
}

model EntityTag {
  id            String   @id @default(cuid())
  entityId      String
  tagId         String
  verified      Boolean  @default(false)  // For FRIENDLINESS tags
  entity        Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  tag           Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  createdBy     String?  // User ID who added the tag
  
  @@unique([entityId, tagId])
  @@index([entityId])
  @@index([tagId])
}

model Approval {
  id                 String         @id @default(cuid())
  type               ApprovalType
  status             ApprovalStatus @default(PENDING)
  
  // NEW_ENTITY: the full proposed entity. UPDATE_ENTITY: only the changed
  // fields. Column keeps its old name so deploys don't break the running app.
  payload            Json           @map("proposedEntityData")

  // UPDATE_ENTITY only: entity version and values of the changed fields at
  // submission time. Approval refuses fields that changed since (conflicts).
  baseVersion        Int?
  baseValues         Json?

  // Automated checks run at submission (geocoding, coverage area)
  checks             Json?

  // Target entity for updates (null for NEW_ENTITY). SetNull keeps the
  // approval history when an entity is deleted.
  targetEntityId     String?
  targetEntity       Entity?        @relation("ApprovalTargetEntity", fields: [targetEntityId], references: [id], onDelete: SetNull)

  // Backward link to created entity (for NEW_ENTITY approvals once approved)
  entityId           String?
  entity             Entity?        @relation("ApprovalCreatedEntity", fields: [entityId], references: [id], onDelete: SetNull)
  
  // Submitter info
  submittedBy        String?        // User ID (nullable for public/AI submissions)
  submitterEmail     String?        // For public submissions
  source             String?        // "ai", "public", "owner", "admin"
  
  // Review info
  reviewedBy         String?        // Admin ID who reviewed
  reviewedAt         DateTime?
  notes              String?        @db.Text
  
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  
  @@index([status])
  @@index([type])
  @@index([entityId])
  @@index([targetEntityId])
  @@index([submittedBy])
}

model IssueReport {
  id            String   @id @default(cuid())
  entityId      String
  entity        Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  issueType     IssueType
  description   String   @db.Text
  submitterEmail String
  submitterName String?
  status        ReportStatus @default(PENDING)
  reviewedBy    String?
  reviewedAt    DateTime?
  resolution    String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([status])
  @@index([entityId])
}

model Subscriber {
  id            String   @id @default(cuid())
  email         String   @unique
  verified      Boolean  @default(false)
  verificationToken String? @unique
  verifiedAt    DateTime?
  preferences   Json?    // Subscription preferences (newsletter, updates, etc.)
  unsubscribed  Boolean  @default(false)
  unsubscribedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([email])
  @@index([verified])
}

model MagicLink {
  id            String   @id @default(cuid())
  email         String
  token         String   @unique
  purpose       MagicLinkPurpose
  expiresAt     DateTime
  used          Boolean  @default(false)
  usedAt        DateTime?
  createdAt     DateTime @default(now())
  
  @@index([token])
  @@index([email])
}

// Enums

enum MemberRole {
  OWNER
  MANAGER
}

enum EntityType {
  COMMERCE
  CIVIC
  PUBLIC_SPACE
  NON_PROFIT
  EVENT
  SERVICE_PROVIDER
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum TagCategory {
  IDENTITY        // Owner-assigned: Black-owned, LGBTQ-owned, etc.
  FRIENDLINESS    // Admin-verified: Kid-friendly, Dog-friendly, etc.
  AMENITY         // Open: WiFi, Outdoor Seating, etc.
}

enum ApprovalType {
  NEW_ENTITY
  UPDATE_ENTITY
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IssueType {
  INCORRECT_INFO
  CLOSED
  INELIGIBLE
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum MagicLinkPurpose {
  VERIFY_SUBSCRIPTION
  MANAGE_PREFERENCES
}

// Better Auth (src/lib/better-auth.ts). Shapes match better-auth 1.7.

model AuthSession {
  id             String   @id
  token          String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  // Signed in with a passkey or an authenticator code (admin powers need this)
  strongAuth     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String    // "credential" holds the password hash
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime? @default(now())

  @@index([userId])
  @@index([credentialID])
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
}
